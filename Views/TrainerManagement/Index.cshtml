@model IEnumerable<GymManagementSystem.Models.Trainer>

@{
    ViewData["Title"] = "Trainer Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Trainer Management</h1>
            <p class="text-muted mb-0">Manage gym trainers, specializations, contact details, and trainer accounts.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Add New Trainer
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-3">No trainers found in the system.</p>
                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">Add the First Trainer</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Specialization</th>
                                <th>Hire Date</th>
                                <th>Account Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td><span class="badge bg-info text-dark">@item.Specialization</span></td>
                                    <td>@item.HireDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.UserId))
                                        {
                                            <span class="badge bg-success">Active Account</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">No Account</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.TrainerId" class="btn btn-outline-secondary" title="View Details">
                                                Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.TrainerId" class="btn btn-outline-primary" title="Edit Trainer">
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.TrainerId" class="btn btn-outline-danger" title="Delete Trainer">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
