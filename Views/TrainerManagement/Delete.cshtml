@model GymManagementSystem.Models.Trainer

@{
    ViewData["Title"] = "Delete Trainer";
    var hasRelatedPlans = (Model.WorkoutPlans?.Count ?? 0) > 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 text-danger mb-0">Delete Trainer</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (hasRelatedPlans)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    <h5 class="alert-heading">Notice: Cannot Delete Trainer</h5>
                    <p class="mb-0">
                        This trainer is currently assigned to <strong>@Model.WorkoutPlans!.Count</strong> workout plan(s).
                    </p>
                    <hr />
                    <p class="mb-0 small text-muted">
                        Due to database referential integrity (Restrict delete), you cannot delete a trainer who has assigned workout plans. Please remove or reassign those workout plans first.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <h5 class="alert-heading">Are you sure you want to delete this trainer?</h5>
                    <p class="mb-0">
                        This will permanently delete the trainer profile and their linked Identity login account 
                        @(string.IsNullOrEmpty(Model.UserId) ? "" : $"({Model.User?.UserName ?? Model.Email})"). 
                        This action cannot be undone.
                    </p>
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0">Trainer Profile: @Model.FullName</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Trainer ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.TrainerId</dd>

                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Email Address</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted">Phone Number</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted">Specialization</dt>
                        <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.Specialization</span></dd>

                        <dt class="col-sm-4 text-muted">Hire Date</dt>
                        <dd class="col-sm-8">@Model.HireDate.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Linked Login Account</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.UserId))
                            {
                                <span class="badge bg-success">Yes (@(Model.User?.UserName ?? Model.Email))</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Account</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

                    @if (!hasRelatedPlans)
                    {
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="TrainerId" />
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" disabled title="Cannot delete trainer with assigned workout plans">Delete Blocked</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
