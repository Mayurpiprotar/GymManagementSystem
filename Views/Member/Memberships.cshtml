@model IEnumerable<GymManagementSystem.Models.Membership>

@{
    ViewData["Title"] = "My Memberships";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">My Memberships</h1>
            <p class="text-muted mb-0">Track all current subscriptions, validity periods, training preferences, and coach assignments.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Plans" class="btn btn-primary">
                Browse Plans
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Dashboard
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-3">You do not have any membership records yet.</p>
                <a asp-action="Plans" class="btn btn-primary">Find a Membership Plan &rarr;</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ms in Model)
            {
                <div class="col-md-6 col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark fs-5">@(ms.MembershipPlan?.Name ?? "Membership Plan")</span>
                                <span class="text-muted small d-block">Order #@ms.MembershipId</span>
                            </div>
                            <div>
                                @if (ms.Status == "Active")
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6">Active</span>
                                }
                                else if (ms.Status == "Upcoming")
                                {
                                    <span class="badge bg-info text-dark px-3 py-2 fs-6">Upcoming</span>
                                }
                                else if (ms.Status == "PendingPayment")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">Pending Payment</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 fs-6">Expired</span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- Validity Dates -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="text-muted small">Start Date</div>
                                        <div class="fw-bold">@ms.StartDate.ToString("yyyy-MM-dd")</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="text-muted small">End Date</div>
                                        <div class="fw-bold text-primary">@ms.EndDate.ToString("yyyy-MM-dd")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Training Preferences -->
                            <dl class="row small mb-0">
                                <dt class="col-5 text-muted">Training Goal:</dt>
                                <dd class="col-7 fw-semibold">
                                    <span class="badge bg-info text-dark">
                                        @(ms.TrainingGoalSpecialization?.Name ?? "General Fitness")
                                    </span>
                                </dd>

                                <dt class="col-5 text-muted">Experience Level:</dt>
                                <dd class="col-7">@(ms.ExperienceLevel ?? "Beginner")</dd>

                                <dt class="col-5 text-muted">Preference:</dt>
                                <dd class="col-7 text-truncate" title="@ms.TrainingPreference">
                                    @(string.IsNullOrWhiteSpace(ms.TrainingPreference) ? "General Workout" : ms.TrainingPreference)
                                </dd>

                                <dt class="col-5 text-muted">Assigned Coach:</dt>
                                <dd class="col-7">
                                    @if (ms.AssignedTrainer != null)
                                    {
                                        <div>
                                            <span class="fw-bold text-success">@ms.AssignedTrainer.FullName</span>
                                            <span class="text-muted small d-block">@ms.AssignedTrainer.Email</span>
                                        </div>
                                        <div class="mt-1">
                                            @if (ms.AssignedTrainer.TrainerSpecializations != null && ms.AssignedTrainer.TrainerSpecializations.Any())
                                            {
                                                @foreach (var ts in ms.AssignedTrainer.TrainerSpecializations)
                                                {
                                                    <span class="badge bg-light text-dark border me-1 small">@(ts.Specialization?.Name ?? "Fitness")</span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(ms.AssignedTrainer.Specialization))
                                            {
                                                <span class="badge bg-light text-dark border small">@ms.AssignedTrainer.Specialization</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Trainer assignment pending</span>
                                    }
                                </dd>
                            </dl>
                        </div>

                        <div class="card-footer bg-white border-0 p-3 pt-0">
                            @if (ms.Status == "PendingPayment")
                            {
                                <a asp-action="Checkout" asp-route-id="@ms.MembershipId" class="btn btn-warning text-dark w-100 fw-semibold">
                                    Complete Payment (Checkout) &rarr;
                                </a>
                            }
                            else
                            {
                                <div class="d-flex gap-2 w-100">
                                    <a asp-action="Renew" asp-route-id="@ms.MembershipId" class="btn btn-outline-primary btn-sm flex-grow-1 fw-semibold">
                                        Renew Membership &rarr;
                                    </a>
                                    @if (ms.Payments != null && ms.Payments.Any(p => p.Status == "Paid"))
                                    {
                                        var paid = ms.Payments.First(p => p.Status == "Paid");
                                        <a asp-action="PaymentSuccess" asp-route-id="@paid.PaymentId" class="btn btn-outline-secondary btn-sm">
                                            Receipt
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
