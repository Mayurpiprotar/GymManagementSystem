@model GymManagementSystem.Models.WorkoutPlan

@{
    ViewData["Title"] = $"Workout Routine — {Model.PlanName}";
}

<div class="container mt-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Workout Routine</li>
                </ol>
            </nav>
            <h1 class="h2 mb-0 fw-bold">@Model.PlanName</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            &larr; Back to Dashboard
        </a>
    </div>

    <div class="row g-4 mb-4">
        <!-- Routine Details Card -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold">Prescribed Training Schedule</h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary">
                        Prescribed on @Model.CreatedDate.ToString("MMMM dd, yyyy")
                    </span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3">@Model.PlanName</h5>

                    <div class="p-3 bg-light rounded border mb-4">
                        <h6 class="fw-semibold text-muted text-uppercase small mb-2">Workout Routine &amp; Exercises</h6>
                        <p class="mb-0 text-dark" style="white-space: pre-line; line-height: 1.6;">@Model.Description</p>
                    </div>

                    <div class="alert alert-info py-2 px-3 small mb-0" role="alert">
                        <strong>Coaching Note:</strong> Perform each exercise with proper form. If you experience unexpected discomfort, consult your assigned coach.
                    </div>
                </div>
            </div>
        </div>

        <!-- Coach Information Card -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 fw-semibold">Assigned Coach</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center fw-bold fs-3" style="width: 72px; height: 72px;">
                            &#127947;
                        </div>
                        <h5 class="fw-bold mt-2 mb-0">@(Model.Trainer?.FullName ?? "Certified Gym Coach")</h5>
                        <span class="text-muted small">Personal Fitness Instructor</span>
                    </div>

                    <dl class="row mb-0 small">
                        <dt class="col-sm-4 text-muted">Specialty</dt>
                        <dd class="col-sm-8 text-dark">
                            @(string.IsNullOrWhiteSpace(Model.Trainer?.Specialization) ? "General Fitness" : Model.Trainer.Specialization)
                        </dd>

                        @if (Model.Trainer?.TrainerSpecializations != null && Model.Trainer.TrainerSpecializations.Any())
                        {
                            <dt class="col-sm-4 text-muted">Expertise</dt>
                            <dd class="col-sm-8">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var ts in Model.Trainer.TrainerSpecializations)
                                    {
                                        <span class="badge bg-info-subtle text-dark border">
                                            @(ts.Specialization?.Name ?? "Discipline")
                                        </span>
                                    }
                                </div>
                            </dd>
                        }

                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8 text-dark text-truncate">@(Model.Trainer?.Email ?? "gym.trainer@gym.com")</dd>

                        <dt class="col-sm-4 text-muted">Phone</dt>
                        <dd class="col-sm-8 text-dark">@(string.IsNullOrWhiteSpace(Model.Trainer?.Phone) ? "Gym Desk" : Model.Trainer.Phone)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
