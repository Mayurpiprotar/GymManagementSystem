@{
    ViewData["Title"] = "Member Dashboard";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <h1 class="display-5 text-success mb-3">Member Dashboard</h1>
            <p class="lead text-muted">Welcome to your Member area. This is a placeholder destination for authenticated Member users.</p>
            <p class="text-muted">Logged in as: <strong>@User.Identity?.Name</strong></p>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline mt-3">
                <button type="submit" class="btn btn-outline-danger">Logout</button>
            </form>
        </div>
    </div>
</div>
