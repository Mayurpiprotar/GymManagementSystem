@model GymManagementSystem.Models.ViewModels.MemberDashboardViewModel

@{
    ViewData["Title"] = "Member Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Member Dashboard</h1>
            <p class="text-muted mb-0">Welcome back, <span class="fw-semibold text-dark">@Model.MemberName</span>!</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Plans" class="btn btn-outline-primary">
                Browse Plans
            </a>
            <span class="badge bg-light text-dark border px-3 py-2 d-flex align-items-center">
                Member ID: #@Model.MemberId
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.ReferralInfo != null)
    {
        <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff; border-radius: 12px;">
            <div class="card-body p-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark fw-bold px-2 py-1">REFERRAL REWARDS</span>
                            <span class="badge bg-success text-light">Up to 20% OFF Renewals</span>
                        </div>
                        <h4 class="fw-bold text-white mb-1">Invite Friends, Work Out Together &amp; Save!</h4>
                        <p class="text-light-50 small mb-3" style="color: #cbd5e1;">
                            Share your personal referral code. When a friend joins IronPulse, they get 10% OFF their first plan, and you unlock automatic discount savings on your next membership renewal!
                        </p>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="small" style="color: #94a3b8;">Your Code:</span>
                            <div class="input-group" style="max-width: 250px;">
                                <input type="text" class="form-control form-control-sm font-monospace fw-bold text-dark bg-light" value="@Model.ReferralInfo.ReferralCode" readonly />
                                <button class="btn btn-sm btn-warning fw-semibold px-3" type="button" onclick="navigator.clipboard.writeText('@Model.ReferralInfo.ReferralCode'); alert('Referral code copied to clipboard!');">
                                    Copy
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-light small">Friends Referred</span>
                                <span class="fs-4 fw-bold text-warning">@Model.ReferralInfo.TotalReferredFriends</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-light small">Your Renewal Discount</span>
                                <span class="fs-4 fw-bold text-success">@Model.ReferralInfo.NextRenewalDiscountPercent% OFF</span>
                            </div>
                            <div class="small pt-2 border-top border-secondary text-light-50" style="color: #94a3b8; font-size: 0.8rem;">
                                <span>Tier Ladder: 1 friend = 10% &bull; 2 friends = 15% &bull; 4+ friends = 20%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Membership Card Column -->
        <div class="col-lg-8 mb-4">
            @if (Model.HasMembership && Model.CurrentMembership != null)
            {
                var cur = Model.CurrentMembership;
                var plan = cur.MembershipPlan;

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold">Current Membership</h5>
                        @if (cur.Status == "Active")
                        {
                            <span class="badge bg-success fs-6 px-3 py-1">Active</span>
                        }
                        else if (cur.Status == "Upcoming")
                        {
                            <span class="badge bg-info text-dark fs-6 px-3 py-1">Upcoming</span>
                        }
                        else if (cur.Status == "PendingPayment")
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-1">Pending Payment</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6 px-3 py-1">Expired</span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <div class="row align-items-center mb-4">
                            <div class="col-md-7">
                                <h3 class="fw-bold mb-1 text-primary">@plan?.Name</h3>
                                <p class="text-muted mb-0">
                                    @(string.IsNullOrWhiteSpace(plan?.Description) ? "Full access membership package." : plan?.Description)
                                </p>
                            </div>
                            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                <span class="display-6 fw-bold text-success">₹@plan?.Price.ToString("0.00")</span>
                                <div class="text-muted small">for @plan?.DurationInMonths @(plan?.DurationInMonths == 1 ? "month" : "months")</div>
                            </div>
                        </div>

                        <hr />

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Start Date</div>
                                    <div class="fw-bold fs-5 text-dark">@cur.StartDate.ToString("MMMM dd, yyyy")</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">End Date</div>
                                    <div class="fw-bold fs-5 text-primary">@cur.EndDate.ToString("MMMM dd, yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Structured Training Preferences & Coach Assignment -->
                        <div class="p-3 border rounded mb-3 bg-light">
                            <h6 class="fw-bold text-dark mb-2">Training Profile &amp; Coach Assignment</h6>
                            <dl class="row small mb-0">
                                <dt class="col-sm-4 text-muted">Training Goal:</dt>
                                <dd class="col-sm-8 fw-semibold">
                                    <span class="badge bg-info text-dark">
                                        @(cur.TrainingGoalSpecialization?.Name ?? "General Fitness")
                                    </span>
                                </dd>

                                <dt class="col-sm-4 text-muted">Experience Level:</dt>
                                <dd class="col-sm-8">@(cur.ExperienceLevel ?? "Beginner")</dd>

                                <dt class="col-sm-4 text-muted">Preferences:</dt>
                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(cur.TrainingPreference) ? "General Workout" : cur.TrainingPreference)</dd>

                                <dt class="col-sm-4 text-muted">Assigned Coach:</dt>
                                <dd class="col-sm-8">
                                    @if (cur.AssignedTrainer != null)
                                    {
                                        <div>
                                            <span class="fw-bold text-success fs-6">@cur.AssignedTrainer.FullName</span>
                                            <span class="text-muted small ms-1">(@cur.AssignedTrainer.Email)</span>
                                        </div>
                                        <div class="mt-1">
                                            @if (cur.AssignedTrainer.TrainerSpecializations != null && cur.AssignedTrainer.TrainerSpecializations.Any())
                                            {
                                                @foreach (var ts in cur.AssignedTrainer.TrainerSpecializations)
                                                {
                                                    <span class="badge bg-light text-dark border me-1 small">@(ts.Specialization?.Name ?? "Fitness")</span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(cur.AssignedTrainer.Specialization))
                                            {
                                                <span class="badge bg-light text-dark border small">@cur.AssignedTrainer.Specialization</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Trainer assignment pending</span>
                                    }
                                </dd>
                            </dl>
                        </div>

                        <!-- Status Notification & Actions -->
                        @if (cur.Status == "PendingPayment")
                        {
                            <div class="alert alert-warning d-flex justify-content-between align-items-center mb-0">
                                <div>
                                    <strong>Payment Required:</strong> Your membership order is pending payment.
                                </div>
                                <a asp-action="Checkout" asp-route-id="@cur.MembershipId" class="btn btn-warning text-dark fw-semibold">
                                    Complete Payment &rarr;
                                </a>
                            </div>
                        }
                        else if (cur.Status == "Active")
                        {
                            <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center mb-0">
                                <div class="small text-muted">
                                    <strong>Status:</strong> Your membership is active. Enjoy full facility access and coaching!
                                </div>
                                <a asp-action="Renew" asp-route-id="@cur.MembershipId" class="btn btn-outline-primary btn-sm ms-3 text-nowrap fw-semibold">
                                    Renew Membership &rarr;
                                </a>
                            </div>
                        }
                        else if (cur.Status == "Upcoming")
                        {
                            <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center mb-0">
                                <div class="small text-muted">
                                    <strong>Status:</strong> Your membership is scheduled to activate on <strong>@cur.StartDate.ToString("yyyy-MM-dd")</strong>.
                                </div>
                                <a asp-action="Renew" asp-route-id="@cur.MembershipId" class="btn btn-outline-primary btn-sm ms-3 text-nowrap fw-semibold">
                                    Renew / Extend &rarr;
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-0">
                                <div>Your membership has expired.</div>
                                <a asp-action="Renew" asp-route-id="@cur.MembershipId" class="btn btn-primary btn-sm fw-semibold">
                                    Renew Membership &rarr;
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body text-center py-5">
                        <div class="mb-3">
                            <span class="display-4 text-warning">&#9888;</span>
                        </div>
                        <h4 class="fw-bold mb-2">No active membership found.</h4>
                        <p class="text-muted mb-4">
                            You currently do not have an active gym membership subscription. Browse our membership plans and select your training preferences to join!
                        </p>
                        <a asp-action="Plans" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            Browse Membership Plans &rarr;
                        </a>
                    </div>
                </div>
            }

            <!-- Payment History Section -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">Recent Payment History</h5>
                    <a asp-action="Payments" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.PaymentHistory != null && Model.PaymentHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Plan</th>
                                        <th>Amount</th>
                                        <th>Method</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.PaymentHistory.Take(5))
                                    {
                                        <tr>
                                            <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                            <td class="fw-semibold">
                                                @(payment.Membership?.MembershipPlan?.Name ?? "Membership")
                                            </td>
                                            <td class="fw-bold @(payment.Status == "Paid" ? "text-success" : "text-dark")">
                                                ₹@payment.Amount.ToString("0.00")
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@payment.PaymentMethod</span>
                                            </td>
                                            <td>
                                                @if (payment.Status == "Paid")
                                                {
                                                    <span class="badge bg-success">Paid</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@payment.Status</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (payment.Status == "Paid")
                                                {
                                                    <a asp-action="PaymentSuccess" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-primary">Receipt</a>
                                                    <a asp-action="DownloadReceipt" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-success ms-1" title="Download Official Tax Receipt PDF"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                                                }
                                                else
                                                {
                                                    <a asp-action="Checkout" asp-route-id="@payment.MembershipId" class="btn btn-sm btn-outline-warning text-dark">Retry</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            No payment transactions recorded yet.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Side: Profile Summary & Workout Plans -->
        <div class="col-lg-4">
            <!-- Member Profile Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">My Profile</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex justify-content-center align-items-center" style="width: 64px; height: 64px; font-size: 24px;">
                            @(string.IsNullOrEmpty(Model.MemberName) ? "M" : Model.MemberName.Substring(0, 1).ToUpper())
                        </div>
                        <h5 class="fw-bold mt-2 mb-0">@Model.MemberName</h5>
                        <p class="text-muted small">@Model.Email</p>
                    </div>

                    <dl class="row small mb-0">
                        <dt class="col-5 text-muted">Member Since</dt>
                        <dd class="col-7 text-end">@Model.JoinDate.ToString("MMMM yyyy")</dd>

                        <dt class="col-5 text-muted">Contact Phone</dt>
                        <dd class="col-7 text-end">@Model.Phone</dd>
                    </dl>

                    <div class="d-grid gap-2 mt-3 pt-3 border-top">
                        <a asp-action="Memberships" class="btn btn-sm btn-outline-primary">
                            View All Subscriptions
                        </a>
                        <a asp-action="Payments" class="btn btn-sm btn-outline-secondary">
                            View Payment Receipts
                        </a>
                    </div>
                </div>
            </div>

            <!-- Workout Plans Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">Assigned Workout Routines</h5>
                    <span class="badge bg-secondary">@Model.WorkoutPlans.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.WorkoutPlans != null && Model.WorkoutPlans.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var wp in Model.WorkoutPlans)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold text-dark">@wp.PlanName</div>
                                            <div class="text-muted small">
                                                Coach: @(wp.Trainer?.FullName ?? "Staff Coach") &bull; @wp.CreatedDate.ToString("yyyy-MM-dd")
                                            </div>
                                        </div>
                                        <a asp-action="WorkoutPlanDetails" asp-route-id="@wp.WorkoutPlanId" class="btn btn-outline-primary btn-sm ms-2 text-nowrap">
                                            View Details &rarr;
                                        </a>
                                    </div>
                                    <p class="small text-muted mb-0 mt-2 text-truncate" style="max-width: 340px;">@wp.Description</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            No workout routines assigned yet. Your coach will prepare personalized routines once trainer matching completes.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
