@model IEnumerable<GymManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "My Payment History";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">My Payment History</h1>
            <p class="text-muted mb-0">Record of all transactions, receipts, and membership payments.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-3">No payments recorded for your account yet.</p>
                    <a asp-action="Plans" class="btn btn-primary">Browse Membership Plans</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Plan / Subscription</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Transaction ID</th>
                                <th>Status</th>
                                <th class="text-end">Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td class="text-muted">#@payment.PaymentId</td>
                                    <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @(payment.Membership?.MembershipPlan?.Name ?? "Membership Subscription")
                                        </div>
                                        <div class="small text-muted">
                                            Order #@payment.MembershipId
                                        </div>
                                    </td>
                                    <td class="fw-bold @(payment.Status == "Paid" ? "text-success" : "text-dark")">
                                        ₹@payment.Amount.ToString("0.00")
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@payment.PaymentMethod</span>
                                    </td>
                                    <td>
                                        <span class="font-monospace small text-muted">
                                            @(string.IsNullOrWhiteSpace(payment.TransactionId) ? "N/A" : payment.TransactionId)
                                        </span>
                                    </td>
                                    <td>
                                        @if (payment.Status == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (payment.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (payment.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@payment.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (payment.Status == "Paid")
                                        {
                                            <a asp-action="PaymentSuccess" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-primary">
                                                Receipt
                                            </a>
                                            <a asp-action="DownloadReceipt" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-success ms-1" title="Download Official PDF Tax Receipt">
                                                <i class="bi bi-file-earmark-pdf"></i> Download PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Checkout" asp-route-id="@payment.MembershipId" class="btn btn-sm btn-outline-warning text-dark">
                                                Retry
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
