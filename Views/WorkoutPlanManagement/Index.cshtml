@model IEnumerable<GymManagementSystem.Models.WorkoutPlan>

@{
    ViewData["Title"] = "Workout Plan Oversight";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Workout Plan Oversight</h1>
            <p class="text-muted mb-0">Oversee all workout plans created by gym trainers across members.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No workout plans have been created by trainers yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Plan ID</th>
                                <th>Plan Name</th>
                                <th>Member</th>
                                <th>Assigned Trainer</th>
                                <th>Created Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@item.WorkoutPlanId</td>
                                    <td class="fw-semibold text-primary">@item.PlanName</td>
                                    <td>
                                        <div>@item.Member?.FullName</div>
                                        <div class="small text-muted">@item.Member?.Email</div>
                                    </td>
                                    <td>
                                        <div>@item.Trainer?.FullName</div>
                                        <div class="small text-muted">@item.Trainer?.Specialization</div>
                                    </td>
                                    <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.WorkoutPlanId" class="btn btn-outline-secondary" title="View Details">
                                                Details
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.WorkoutPlanId" class="btn btn-outline-danger" title="Delete Plan">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
