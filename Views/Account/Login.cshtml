@model GymManagementSystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log in - IronPulse Gym";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Header Accent -->
            <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: linear-gradient(135deg, #111827 0%, #1e3a8a 100%);">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-25 rounded-circle p-3 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-box-arrow-in-right text-warning" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14 2H6a1.5 1.5 0 0 0-1.5 1.5v2a.5.5 0 0 0 1 0z"/>
                        <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                    </svg>
                </div>
                <h2 class="h3 fw-bold mb-1 text-white">Welcome Back</h2>
                <p class="text-light text-opacity-75 small mb-0">Sign in to your IronPulse fitness account</p>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
                        <strong>Success!</strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 small mb-4" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" method="post" asp-route-returnurl="@Model.ReturnUrl">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="EmailOrUsername" class="form-label fw-semibold small text-secondary">Email Address or Username</label>
                        <input asp-for="EmailOrUsername" class="form-control rounded-3 py-2" autocomplete="username" placeholder="name@example.com" />
                        <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label fw-semibold small text-secondary mb-0"></label>
                        </div>
                        <input asp-for="Password" class="form-control rounded-3 py-2" autocomplete="current-password" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3 shadow-sm py-2">
                            Sign In &rarr;
                        </button>
                    </div>

                    <div class="text-center pt-2">
                        <p class="mb-0 text-muted small">New to IronPulse? <a asp-action="Register" class="fw-bold text-decoration-none">Create an account</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
