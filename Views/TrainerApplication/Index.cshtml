@model IEnumerable<GymManagementSystem.Models.TrainerApplication>

@{
    ViewData["Title"] = "Trainer Applications";
    var currentFilter = ViewData["CurrentFilter"] as string ?? "All";
    var pendingCount = ViewData["PendingCount"] as int? ?? 0;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Trainer Applications</h1>
            <p class="text-muted mb-0">Review, verify certifications, and approve or reject applicant trainer registrations.</p>
        </div>
        <div>
            @if (pendingCount > 0)
            {
                <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                    @pendingCount Pending Review@(pendingCount > 1 ? "s" : "")
                </span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Navigation Tabs -->
    <div class="mb-3">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-statusFilter="All" class="btn btn-outline-secondary @(currentFilter == "All" ? "active" : "")">
                All Applications
            </a>
            <a asp-action="Index" asp-route-statusFilter="Pending" class="btn btn-outline-warning text-dark @(currentFilter == "Pending" ? "active" : "")">
                Pending (@pendingCount)
            </a>
            <a asp-action="Index" asp-route-statusFilter="Approved" class="btn btn-outline-success @(currentFilter == "Approved" ? "active" : "")">
                Approved
            </a>
            <a asp-action="Index" asp-route-statusFilter="Rejected" class="btn btn-outline-danger @(currentFilter == "Rejected" ? "active" : "")">
                Rejected
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No trainer applications found for the selected filter.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Applicant</th>
                                <th>Contact</th>
                                <th>Experience</th>
                                <th>Specializations</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="text-muted">#@app.TrainerApplicationId</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@app.FullName</div>
                                        <div class="small text-muted text-truncate" style="max-width: 240px;">
                                            @app.QualificationsSummary
                                        </div>
                                    </td>
                                    <td>
                                        <div>@app.Email</div>
                                        <div class="small text-muted">@app.Phone</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@app.ExperienceYears yrs</span>
                                    </td>
                                    <td>
                                        @if (app.ApplicationSpecializations != null && app.ApplicationSpecializations.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var tas in app.ApplicationSpecializations)
                                                {
                                                    <span class="badge bg-info text-dark">@tas.Specialization?.Name</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                    <td>@app.AppliedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (app.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1">Pending</span>
                                        }
                                        else if (app.Status == "Approved")
                                        {
                                            <span class="badge bg-success px-2 py-1">Approved</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger px-2 py-1">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">@app.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@app.TrainerApplicationId" class="btn btn-outline-secondary" title="View Application Details">
                                                View
                                            </a>
                                            @if (app.Status == "Pending")
                                            {
                                                <form asp-action="Approve" asp-route-id="@app.TrainerApplicationId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to approve @app.FullName as a registered Trainer?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success" title="Approve Application">
                                                        Approve
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal_@app.TrainerApplicationId" title="Reject Application">
                                                    Reject
                                                </button>
                                            }
                                        </div>

                                        <!-- Rejection Modal -->
                                        @if (app.Status == "Pending")
                                        {
                                            <div class="modal fade text-start" id="rejectModal_@app.TrainerApplicationId" tabindex="-1" aria-labelledby="rejectModalLabel_@app.TrainerApplicationId" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="Reject" asp-route-id="@app.TrainerApplicationId" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <div class="modal-header bg-danger text-white">
                                                                <h5 class="modal-title" id="rejectModalLabel_@app.TrainerApplicationId">Reject Trainer Application</h5>
                                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>Are you sure you want to reject the application for <strong>@app.FullName</strong>?</p>
                                                                <div class="mb-3">
                                                                    <label for="adminNotes_@app.TrainerApplicationId" class="form-label fw-semibold">Reason for Rejection (Notes):</label>
                                                                    <textarea name="adminNotes" id="adminNotes_@app.TrainerApplicationId" class="form-control" rows="3" maxlength="500" placeholder="Specify why the application does not meet criteria..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
