@model GymManagementSystem.Models.TrainerApplication

@{
    ViewData["Title"] = $"Application #{Model.TrainerApplicationId} - {Model.FullName}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Trainer Application Review</h1>
            <p class="text-muted mb-0">Application #@Model.TrainerApplicationId &bull; Submitted on @Model.AppliedDate.ToString("yyyy-MM-dd")</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                &larr; Back to Applications
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Applicant Details & Credentials -->
        <div class="col-lg-8">
            <!-- Applicant Information -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Applicant Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Email Address</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </dd>

                        <dt class="col-sm-4 text-muted">Phone Number</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted">Experience</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.ExperienceYears years</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Qualifications Summary -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Qualifications &amp; Background</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.QualificationsSummary</p>
                </div>
            </div>

            <!-- Selected Specializations -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Requested Specializations</h5>
                </div>
                <div class="card-body">
                    @if (Model.ApplicationSpecializations != null && Model.ApplicationSpecializations.Any())
                    {
                        <div class="row g-2">
                            @foreach (var tas in Model.ApplicationSpecializations)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light">
                                        <div class="fw-semibold text-dark">@tas.Specialization?.Name</div>
                                        <div class="text-muted small">@tas.Specialization?.Description</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No specializations linked to this application.</p>
                    }
                </div>
            </div>

            <!-- Verification Documents -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Verification Documents</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <!-- Primary Certification Document -->
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div>
                                <div class="fw-semibold text-dark">Primary Certification Document</div>
                                <div class="text-muted small">
                                    Original File: @Model.CertificationOriginalFileName
                                </div>
                            </div>
                            <a asp-action="DownloadProof" asp-route-id="@Model.TrainerApplicationId" asp-route-type="certification" class="btn btn-sm btn-outline-primary" target="_blank">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                                </svg>
                                Download Proof
                            </a>
                        </div>

                        <!-- Secondary / Experience Document -->
                        @if (!string.IsNullOrEmpty(Model.ExperienceDocumentPath))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <div>
                                    <div class="fw-semibold text-dark">Experience Document</div>
                                    <div class="text-muted small">
                                        Original File: @(Model.ExperienceOriginalFileName ?? "Experience Document")
                                    </div>
                                </div>
                                <a asp-action="DownloadProof" asp-route-id="@Model.TrainerApplicationId" asp-route-type="experience" class="btn btn-sm btn-outline-secondary" target="_blank">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
                                        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                        <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                                    </svg>
                                    Download Proof
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Status & Administrative Actions -->
        <div class="col-lg-4">
            <!-- Application Status Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Application Status</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark fs-5 px-3 py-2">Pending Review</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success fs-5 px-3 py-2">Approved</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger fs-5 px-3 py-2">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-5 px-3 py-2">@Model.Status</span>
                        }
                    </div>

                    <dl class="row small mb-0">
                        <dt class="col-6 text-muted">Applied Date</dt>
                        <dd class="col-6 text-end">@Model.AppliedDate.ToString("yyyy-MM-dd")</dd>

                        @if (Model.ReviewedDate.HasValue)
                        {
                            <dt class="col-6 text-muted">Reviewed Date</dt>
                            <dd class="col-6 text-end">@Model.ReviewedDate.Value.ToString("yyyy-MM-dd")</dd>
                        }

                        @if (Model.ReviewedByAdmin != null)
                        {
                            <dt class="col-6 text-muted">Reviewed By</dt>
                            <dd class="col-6 text-end text-truncate">@(Model.ReviewedByAdmin.FullName ?? Model.ReviewedByAdmin.Email)</dd>
                        }
                    </dl>

                    @if (!string.IsNullOrEmpty(Model.AdminNotes))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <label class="form-label fw-semibold text-muted small">Admin Notes / Reason:</label>
                            <p class="small text-danger mb-0 fst-italic">@Model.AdminNotes</p>
                        </div>
                    }

                    @if (Model.CreatedTrainer != null)
                    {
                        <div class="mt-3 pt-3 border-top">
                            <label class="form-label fw-semibold text-muted small">Created Trainer Profile:</label>
                            <div>
                                <a asp-controller="TrainerManagement" asp-action="Details" asp-route-id="@Model.CreatedTrainer.TrainerId" class="btn btn-sm btn-outline-success w-100">
                                    View Trainer Profile (#@Model.CreatedTrainer.TrainerId)
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Decision Action Card (Only if Pending) -->
            @if (Model.Status == "Pending")
            {
                <div class="card shadow-sm border-0 border-top border-warning border-3">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold">Administrative Decision</h5>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            Approving will create an active Trainer account and profile with the applicant's credentials.
                        </p>

                        <div class="d-grid gap-2">
                            <form asp-action="Approve" asp-route-id="@Model.TrainerApplicationId" method="post" onsubmit="return confirm('Are you sure you want to approve @Model.FullName as an official gym Trainer?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                                    Approve Application
                                </button>
                            </form>

                            <button type="button" class="btn btn-outline-danger w-100 py-2" data-bs-toggle="modal" data-bs-target="#rejectDetailsModal">
                                Reject Application
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Reject Modal -->
                <div class="modal fade" id="rejectDetailsModal" tabindex="-1" aria-labelledby="rejectDetailsModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="Reject" asp-route-id="@Model.TrainerApplicationId" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title" id="rejectDetailsModalLabel">Reject Trainer Application</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Are you sure you want to reject the application for <strong>@Model.FullName</strong>?</p>
                                    <div class="mb-3">
                                        <label for="adminNotes" class="form-label fw-semibold">Reason for Rejection:</label>
                                        <textarea name="adminNotes" id="adminNotes" class="form-control" rows="3" maxlength="500" placeholder="Specify reasons for rejection..."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
