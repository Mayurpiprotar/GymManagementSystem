@model GymManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Payment Details</h1>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-primary me-2">Edit</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0">Payment Record #@Model.PaymentId</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Payment ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.PaymentId</dd>

                        <dt class="col-sm-4 text-muted">Member Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Member?.FullName</dd>

                        <dt class="col-sm-4 text-muted">Member Email</dt>
                        <dd class="col-sm-8">@Model.Member?.Email</dd>

                        <dt class="col-sm-4 text-muted">Membership ID</dt>
                        <dd class="col-sm-8">#@Model.MembershipId</dd>

                        <dt class="col-sm-4 text-muted">Membership Plan</dt>
                        <dd class="col-sm-8">
                            <span class="fw-semibold">@Model.Membership?.MembershipPlan?.Name</span>
                            <span class="text-muted small">
                                (@Model.Membership?.MembershipPlan?.DurationInMonths @(Model.Membership?.MembershipPlan?.DurationInMonths == 1 ? "month" : "months"))
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Amount</dt>
                        <dd class="col-sm-8 fw-bold text-success fs-5">$@Model.Amount.ToString("0.00")</dd>

                        <dt class="col-sm-4 text-muted">Payment Date</dt>
                        <dd class="col-sm-8">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Payment Method</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-light text-dark border fs-6">@Model.PaymentMethod</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Paid")
                            {
                                <span class="badge bg-success fs-6">Paid</span>
                            }
                            else if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark fs-6">Pending</span>
                            }
                            else if (Model.Status == "Failed")
                            {
                                <span class="badge bg-danger fs-6">Failed</span>
                            }
                            else if (Model.Status == "Refunded")
                            {
                                <span class="badge bg-secondary fs-6">Refunded</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border fs-6">@Model.Status</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light py-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-primary me-2">Edit Payment</a>
                        <a asp-action="Delete" asp-route-id="@Model.PaymentId" class="btn btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
