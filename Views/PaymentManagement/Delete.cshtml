@model GymManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0 text-danger">Delete Payment</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            <div class="card shadow-sm border-0 mb-4 border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0">Confirm Payment Deletion</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Warning:</strong> Are you sure you want to delete this payment record? This action cannot be undone.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Payment ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.PaymentId</dd>

                        <dt class="col-sm-4 text-muted">Member</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Member?.FullName (@Model.Member?.Email)</dd>

                        <dt class="col-sm-4 text-muted">Membership</dt>
                        <dd class="col-sm-8">Membership #@Model.MembershipId - @Model.Membership?.MembershipPlan?.Name</dd>

                        <dt class="col-sm-4 text-muted">Amount</dt>
                        <dd class="col-sm-8 fw-bold text-success fs-5">$@Model.Amount.ToString("0.00")</dd>

                        <dt class="col-sm-4 text-muted">Payment Date</dt>
                        <dd class="col-sm-8">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Payment Method</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-light text-dark border">@Model.PaymentMethod</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Status</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light py-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <form asp-action="Delete" asp-route-id="@Model.PaymentId" method="post">
                        <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
