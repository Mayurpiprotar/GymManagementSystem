@model GymManagementSystem.Models.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Record Payment</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="paymentForm">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        }

                        <div class="mb-3">
                            <label asp-for="MemberId" class="form-label fw-semibold">Select Member *</label>
                            <select asp-for="MemberId" asp-items="Model.MemberList" class="form-select" id="memberSelect">
                                <option value="">-- Choose Member --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MembershipId" class="form-label fw-semibold">Select Membership *</label>
                            <select asp-for="MembershipId" class="form-select" id="membershipSelect">
                                <option value="">-- Choose Membership --</option>
                                @foreach (var ms in Model.AvailableMemberships)
                                {
                                    <option value="@ms.MembershipId" data-member-id="@ms.MemberId" data-price="@ms.PlanPrice" selected="@(ms.MembershipId == Model.MembershipId ? "selected" : null)">
                                        #@ms.MembershipId - @ms.PlanName ($@ms.PlanPrice.ToString("0.00")) [@ms.MemberName]
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="MembershipId" class="text-danger small"></span>
                            <div class="form-text small">Only memberships belonging to the selected member will be accepted.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label fw-semibold">Amount ($) *</label>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" max="100000" id="amountInput" />
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentDate" class="form-label fw-semibold">Payment Date *</label>
                                <input asp-for="PaymentDate" type="date" class="form-control" />
                                <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method *</label>
                                <select asp-for="PaymentMethod" asp-items="Model.PaymentMethodList" class="form-select">
                                </select>
                                <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-semibold">Status *</label>
                                <select asp-for="Status" asp-items="Model.StatusList" class="form-select">
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Record Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const memberSelect = document.getElementById("memberSelect");
            const membershipSelect = document.getElementById("membershipSelect");
            const amountInput = document.getElementById("amountInput");

            function filterMemberships() {
                const selectedMemberId = memberSelect ? memberSelect.value : "";
                const options = membershipSelect.querySelectorAll("option");
                let hasCurrentValidSelection = false;

                options.forEach(opt => {
                    if (!opt.value) return; // Keep "-- Choose Membership --"
                    const memberId = opt.getAttribute("data-member-id");
                    if (!selectedMemberId || memberId === selectedMemberId) {
                        opt.style.display = "";
                        opt.disabled = false;
                        if (opt.selected) hasCurrentValidSelection = true;
                    } else {
                        opt.style.display = "none";
                        opt.disabled = true;
                        if (opt.selected) opt.selected = false;
                    }
                });

                if (!hasCurrentValidSelection && membershipSelect.value) {
                    membershipSelect.value = "";
                }
            }

            if (memberSelect) {
                memberSelect.addEventListener("change", function () {
                    filterMemberships();
                });
            }

            if (membershipSelect) {
                membershipSelect.addEventListener("change", function () {
                    const selectedOpt = membershipSelect.options[membershipSelect.selectedIndex];
                    if (selectedOpt && selectedOpt.dataset.price && (!amountInput.value || parseFloat(amountInput.value) === 0)) {
                        amountInput.value = parseFloat(selectedOpt.dataset.price).toFixed(2);
                    }
                });
            }

            filterMemberships();
        });
    </script>
}
