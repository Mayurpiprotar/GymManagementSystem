@model GymManagementSystem.Models.MembershipPlan

@{
    ViewData["Title"] = "Add Membership Plan";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Add Membership Plan</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        }

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Plan Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Monthly Standard, Annual Premium" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationInMonths" class="form-label fw-semibold">Duration (Months) *</label>
                                <input asp-for="DurationInMonths" type="number" min="1" max="120" class="form-control" />
                                <span asp-validation-for="DurationInMonths" class="text-danger small"></span>
                                <div class="form-text small">Number of months this membership lasts (1 - 120).</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold">Price ($) *</label>
                                <input asp-for="Price" type="number" step="0.01" min="0" max="100000" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                                <div class="form-text small">Cost of the plan in dollars.</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the plan benefits, access privileges, and inclusions..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Create Plan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
