@model GymManagementSystem.Models.MembershipPlan

@{
    ViewData["Title"] = "Delete Membership Plan";
    var hasRelatedMemberships = (Model.Memberships?.Count ?? 0) > 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 text-danger mb-0">Delete Membership Plan</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (hasRelatedMemberships)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    <h5 class="alert-heading">Notice: Cannot Delete Membership Plan</h5>
                    <p class="mb-0">
                        This membership plan currently has <strong>@Model.Memberships!.Count</strong> associated membership record(s) in the system.
                    </p>
                    <hr />
                    <p class="mb-0 small text-muted">
                        Due to database referential integrity (Restrict delete), a membership plan cannot be deleted while member subscriptions are assigned to it.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <h5 class="alert-heading">Are you sure you want to delete this membership plan?</h5>
                    <p class="mb-0">This action cannot be undone. The plan will be permanently removed from the system.</p>
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0">Plan Summary: @Model.Name</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Plan ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.MembershipPlanId</dd>

                        <dt class="col-sm-4 text-muted">Plan Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4 text-muted">Duration</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info text-dark">
                                @Model.DurationInMonths @(Model.DurationInMonths == 1 ? "Month" : "Months")
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Price</dt>
                        <dd class="col-sm-8 fw-bold text-success">$@Model.Price.ToString("0.00")</dd>

                        <dt class="col-sm-4 text-muted">Description</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </dd>

                        <dt class="col-sm-4 text-muted">Associated Memberships</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(hasRelatedMemberships ? "bg-primary" : "bg-secondary")">
                                @(Model.Memberships?.Count ?? 0)
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    
                    @if (!hasRelatedMemberships)
                    {
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="MembershipPlanId" />
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" disabled title="Cannot delete membership plan with associated memberships">Delete Blocked</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
