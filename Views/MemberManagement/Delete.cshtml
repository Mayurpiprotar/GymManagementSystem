@model GymManagementSystem.Models.Member

@{
    ViewData["Title"] = "Delete Member";
    var hasRelatedRecords = (Model.Memberships?.Count ?? 0) > 0 || 
                            (Model.Payments?.Count ?? 0) > 0 || 
                            (Model.WorkoutPlans?.Count ?? 0) > 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 text-danger mb-0">Delete Member</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (hasRelatedRecords)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    <h5 class="alert-heading">Notice: Cannot Delete Member</h5>
                    <p class="mb-0">
                        This member has associated records in the system:
                    </p>
                    <ul class="mb-0 mt-2">
                        @if ((Model.Memberships?.Count ?? 0) > 0)
                        {
                            <li>Memberships: <strong>@Model.Memberships!.Count</strong></li>
                        }
                        @if ((Model.Payments?.Count ?? 0) > 0)
                        {
                            <li>Payments: <strong>@Model.Payments!.Count</strong></li>
                        }
                        @if ((Model.WorkoutPlans?.Count ?? 0) > 0)
                        {
                            <li>Workout Plans: <strong>@Model.WorkoutPlans!.Count</strong></li>
                        }
                    </ul>
                    <hr />
                    <p class="mb-0 small text-muted">
                        Due to database referential integrity (Restrict delete), a member cannot be deleted until all dependent records are removed.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <h5 class="alert-heading">Are you sure you want to delete this member?</h5>
                    <p class="mb-0">This action cannot be undone. All member profile data will be permanently removed.</p>
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0">Member Profile: @Model.FullName</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Member ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.MemberId</dd>

                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Email Address</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted">Phone Number</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted">Date of Birth</dt>
                        <dd class="col-sm-8">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Gender</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Gender</span></dd>

                        <dt class="col-sm-4 text-muted">Join Date</dt>
                        <dd class="col-sm-8">@Model.JoinDate.ToString("yyyy-MM-dd")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    
                    @if (!hasRelatedRecords)
                    {
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="MemberId" />
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" disabled title="Cannot delete member with related records">Delete Blocked</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
