@model GymManagementSystem.Models.ViewModels.MembershipViewModel

@{
    ViewData["Title"] = "Assign Membership";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Assign Membership</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        }

                        <div class="mb-3">
                            <label asp-for="MemberId" class="form-label fw-semibold">Select Member *</label>
                            <select asp-for="MemberId" asp-items="Model.MemberList" class="form-select">
                                <option value="">-- Choose Member --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MembershipPlanId" class="form-label fw-semibold">Select Membership Plan *</label>
                            <select asp-for="MembershipPlanId" asp-items="Model.PlanList" class="form-select">
                                <option value="">-- Choose Plan --</option>
                            </select>
                            <span asp-validation-for="MembershipPlanId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label fw-semibold">Start Date *</label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Status (Automatic)</label>
                                <input type="text" class="form-control bg-light" value="Calculated by Date" readonly />
                                <div class="form-text small">Upcoming if in future, Active if current, Expired if past.</div>
                            </div>
                        </div>

                        <div class="alert alert-info py-2 px-3 small mb-4" role="alert">
                            <strong>Note:</strong> End Date and Status are calculated server-side based on the selected plan duration and current date.
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Create Membership</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
