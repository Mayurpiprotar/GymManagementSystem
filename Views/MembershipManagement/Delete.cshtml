@model GymManagementSystem.Models.Membership

@{
    ViewData["Title"] = "Delete Membership";
    var hasRelatedPayments = (Model.Payments?.Count ?? 0) > 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 text-danger mb-0">Delete Membership</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (hasRelatedPayments)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    <h5 class="alert-heading">Notice: Cannot Delete Membership</h5>
                    <p class="mb-0">
                        This membership currently has <strong>@Model.Payments!.Count</strong> associated payment record(s) in the system.
                    </p>
                    <hr />
                    <p class="mb-0 small text-muted">
                        Due to database referential integrity (Restrict delete), a membership cannot be deleted while payment transactions are recorded for it.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <h5 class="alert-heading">Are you sure you want to delete this membership?</h5>
                    <p class="mb-0">This action cannot be undone. The membership record will be permanently removed.</p>
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0">Membership #@Model.MembershipId</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Membership ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.MembershipId</dd>

                        <dt class="col-sm-4 text-muted">Member</dt>
                        <dd class="col-sm-8">
                            <span class="fw-semibold">@Model.Member?.FullName</span>
                            <span class="text-muted">(@Model.Member?.Email)</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Membership Plan</dt>
                        <dd class="col-sm-8">@Model.MembershipPlan?.Name</dd>

                        <dt class="col-sm-4 text-muted">Start Date</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">End Date</dt>
                        <dd class="col-sm-8">@Model.EndDate.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else if (Model.Status == "Upcoming")
                            {
                                <span class="badge bg-info text-dark">Upcoming</span>
                            }
                            else if (Model.Status == "Expired")
                            {
                                <span class="badge bg-secondary">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">@Model.Status</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Associated Payments</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(hasRelatedPayments ? "bg-primary" : "bg-secondary")">
                                @(Model.Payments?.Count ?? 0)
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    
                    @if (!hasRelatedPayments)
                    {
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="MembershipId" />
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" disabled title="Cannot delete membership with associated payments">Delete Blocked</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
