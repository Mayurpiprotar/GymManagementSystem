@model IEnumerable<GymManagementSystem.Models.Membership>

@{
    ViewData["Title"] = "Membership Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Membership Management</h1>
            <p class="text-muted mb-0">Manage gym memberships, member subscriptions, and duration status.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Assign New Membership
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-3">No memberships found in the system.</p>
                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">Assign the First Membership</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Member</th>
                                <th>Plan</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.Member?.FullName</div>
                                        <div class="small text-muted">@item.Member?.Email</div>
                                    </td>
                                    <td>
                                        <span class="fw-medium">@item.MembershipPlan?.Name</span>
                                        <div class="small text-muted">
                                            @item.MembershipPlan?.DurationInMonths @(item.MembershipPlan?.DurationInMonths == 1 ? "month" : "months") &bull; $@item.MembershipPlan?.Price.ToString("0.00")
                                        </div>
                                    </td>
                                    <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (item.Status == "Upcoming")
                                        {
                                            <span class="badge bg-info text-dark">Upcoming</span>
                                        }
                                        else if (item.Status == "Expired")
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MembershipId" class="btn btn-outline-secondary" title="View Details">
                                                Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MembershipId" class="btn btn-outline-primary" title="Edit Membership">
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MembershipId" class="btn btn-outline-danger" title="Delete Membership">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
