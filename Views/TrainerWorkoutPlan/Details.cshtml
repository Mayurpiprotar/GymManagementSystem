@model GymManagementSystem.Models.WorkoutPlan

@{
    ViewData["Title"] = "Workout Plan Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Workout Plan Details</h1>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.WorkoutPlanId" class="btn btn-primary me-2">Edit</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0">@Model.PlanName</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Plan ID</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.WorkoutPlanId</dd>

                        <dt class="col-sm-4 text-muted">Plan Name</dt>
                        <dd class="col-sm-8 fw-bold text-primary fs-5">@Model.PlanName</dd>

                        <dt class="col-sm-4 text-muted">Member Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Member?.FullName</dd>

                        <dt class="col-sm-4 text-muted">Member Email</dt>
                        <dd class="col-sm-8">@Model.Member?.Email</dd>

                        <dt class="col-sm-4 text-muted">Assigned Trainer</dt>
                        <dd class="col-sm-8">
                            <span class="fw-semibold">@Model.Trainer?.FullName</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Trainer?.Specialization))
                            {
                                <span class="badge bg-info text-dark ms-1">@Model.Trainer?.Specialization</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Created Date</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Routine / Description</dt>
                        <dd class="col-sm-8">
                            <div class="p-3 bg-light rounded text-dark" style="white-space: pre-wrap;">@Model.Description</div>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light py-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.WorkoutPlanId" class="btn btn-primary me-2">Edit Plan</a>
                        <a asp-action="Delete" asp-route-id="@Model.WorkoutPlanId" class="btn btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
