@model GymManagementSystem.Models.ViewModels.TrainerAssignmentDetailViewModel

@{
    ViewData["Title"] = "Assign Trainer — " + Model.MemberName;
}

<div class="container py-4">
    <!-- Breadcrumb & Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Trainer Assignments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Assign Trainer (#@Model.MembershipId)</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark">Trainer Matching &amp; Assignment</h1>
            <p class="text-muted mb-0">Review candidate workload recommendations and finalize trainer assignment for this membership.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                &larr; Back to Assignments List
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span class="fw-semibold">Error:</span> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Member & Subscription Details Overview Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">Member &amp; Subscription Profile</h5>
            <span class="badge bg-light text-primary fs-6 px-3 py-1">Order #@Model.MembershipId</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Member Information Column -->
                <div class="col-md-4 border-end">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">Member Details</h6>
                    <div class="mb-2">
                        <div class="fw-bold fs-5 text-dark">@Model.MemberName</div>
                        <div class="text-muted small">@Model.MemberEmail</div>
                        @if (!string.IsNullOrWhiteSpace(Model.MemberPhone))
                        {
                            <div class="text-muted small">Phone: @Model.MemberPhone</div>
                        }
                    </div>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-light text-dark border">Member ID: #@Model.MemberId</span>
                    </div>
                </div>

                <!-- Membership Subscription Column -->
                <div class="col-md-4 border-end">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">Membership Package</h6>
                    <div class="fw-bold fs-5 text-primary">@Model.PlanName</div>
                    <div class="text-muted small mb-2">Price: ₹@Model.PlanPrice.ToString("0.00")</div>
                    <div class="small">
                        <div class="text-muted">Validity Window:</div>
                        <div class="fw-semibold">@Model.StartDate.ToString("MMM dd, yyyy") &mdash; @Model.EndDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="mt-2">
                        <span class="badge bg-success">Status: @Model.CanonicalStatus</span>
                        <span class="badge bg-success-subtle text-success border border-success">Payment: Paid</span>
                    </div>
                </div>

                <!-- Training Preferences & Current Assignment -->
                <div class="col-md-4">
                    <h6 class="fw-bold text-muted text-uppercase small mb-3">Training Goal &amp; Preferences</h6>
                    <div class="mb-2">
                        <div class="text-muted small">Target Goal:</div>
                        <span class="badge bg-info text-dark fs-6">@Model.TrainingGoalName</span>
                    </div>
                    <div class="small mb-2">
                        <span class="text-muted">Experience:</span>
                        <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.ExperienceLevel) ? "Beginner" : Model.ExperienceLevel)</span>
                    </div>
                    <div class="small mb-3">
                        <span class="text-muted">Preference:</span>
                        <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.TrainingPreference) ? "General Gym Routine" : Model.TrainingPreference)</span>
                    </div>
                    <div class="pt-2 border-top small">
                        <span class="text-muted">Current Coach:</span>
                        @if (Model.CurrentAssignedTrainerId.HasValue)
                        {
                            <span class="fw-bold text-success ms-1">@Model.CurrentAssignedTrainerName</span>
                            <span class="badge bg-secondary-subtle text-secondary ms-1">Assigned</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-1">&#9888; Not Assigned</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- RECOMMENDED TRAINER CALLOUT (PART F)                              -->
    <!-- ================================================================= -->
    @if (Model.RecommendedTrainer != null)
    {
        var rec = Model.RecommendedTrainer;
        <div class="card shadow-sm border-2 border-success mb-4 bg-light">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">&#9733;</span>
                    <h5 class="card-title mb-0 fw-bold">Top System Recommendation</h5>
                </div>
                <span class="badge bg-light text-success fw-bold px-3 py-1">Exact Match &bull; Lowest Workload</span>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h4 class="fw-bold text-dark mb-0">@rec.FullName</h4>
                            <span class="badge bg-success">Recommended</span>
                            <span class="badge bg-info text-dark">Exact Goal Match</span>
                        </div>
                        <div class="text-muted small mb-2">
                            <span>Email: @rec.Email</span>
                            @if (!string.IsNullOrWhiteSpace(rec.Phone))
                            {
                                <span class="ms-3">Phone: @rec.Phone</span>
                            }
                            <span class="ms-3">Hire Date: @rec.HireDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted small">Specializations:</span>
                            @foreach (var s in rec.Specializations)
                            {
                                <span class="badge @(s == Model.TrainingGoalName ? "bg-primary" : "bg-light text-dark border") me-1">
                                    @s
                                </span>
                            }
                        </div>
                        <div class="d-flex gap-3 align-items-center">
                            <span class="badge bg-dark px-3 py-2 fs-6">
                                Active Members: @rec.ActiveWorkload
                            </span>
                            <span class="text-muted small">
                                Deterministic ranking: Exact specialization match with lowest active client workload.
                            </span>
                        </div>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <form asp-action="Assign" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="MembershipId" value="@Model.MembershipId" />
                            <input type="hidden" name="TrainerId" value="@rec.TrainerId" />
                            <input type="hidden" name="ConfirmNonExact" value="false" />
                            <button type="submit" class="btn btn-success btn-lg px-4 fw-bold shadow-sm">
                                @(Model.CurrentAssignedTrainerId == rec.TrainerId ? "Reconfirm Assignment" : "Assign Recommended Trainer &rarr;")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- NO EXACT MATCH WARNING (PART G) -->
        <div class="alert alert-warning border-warning shadow-sm mb-4 p-4" role="alert">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fs-4">&#9888;</span>
                <h5 class="alert-heading fw-bold mb-0">No trainer currently has this specialization.</h5>
            </div>
            <p class="mb-2">
                None of the verified trainers currently possess the exact training goal specialization: <strong>@Model.TrainingGoalName</strong>.
            </p>
            <p class="mb-0 small text-muted">
                As an Administrator, you may manually assign another approved trainer from the list below if gym policy allows.
                Non-matching assignments will require explicit confirmation.
            </p>
        </div>
    }

    <!-- ================================================================= -->
    <!-- CANDIDATE MATCHING TRAINERS TABLE (PART D & E)                    -->
    <!-- ================================================================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">
                Exact Specialization Matches (@Model.MatchingTrainers.Count)
                <span class="text-muted fs-6 fw-normal ms-2">Specialized in "@Model.TrainingGoalName"</span>
            </h5>
            <span class="badge bg-light text-dark border">Sorted by Lowest Workload, then Hire Date</span>
        </div>
        <div class="card-body p-0">
            @if (Model.MatchingTrainers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trainer Name</th>
                                <th>Contact</th>
                                <th>Registered Specializations</th>
                                <th>Active Workload</th>
                                <th>Hire Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trainer in Model.MatchingTrainers)
                            {
                                <tr class="@(trainer.IsRecommended ? "table-success-subtle" : "")">
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @trainer.FullName
                                            @if (trainer.IsRecommended)
                                            {
                                                <span class="badge bg-success ms-1">Recommended</span>
                                            }
                                            @if (Model.CurrentAssignedTrainerId == trainer.TrainerId)
                                            {
                                                <span class="badge bg-primary ms-1">Currently Assigned</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">@trainer.Email</div>
                                        <div class="text-muted small">@trainer.Phone</div>
                                    </td>
                                    <td>
                                        @foreach (var s in trainer.Specializations)
                                        {
                                            <span class="badge @(s == Model.TrainingGoalName ? "bg-primary" : "bg-light text-dark border") me-1">
                                                @s
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-dark px-2 py-1">
                                            Active Members: @trainer.ActiveWorkload
                                        </span>
                                    </td>
                                    <td class="text-nowrap small">
                                        @trainer.HireDate.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="Assign" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MembershipId" value="@Model.MembershipId" />
                                            <input type="hidden" name="TrainerId" value="@trainer.TrainerId" />
                                            <input type="hidden" name="ConfirmNonExact" value="false" />
                                            <button type="submit" class="btn btn-sm @(trainer.IsRecommended ? "btn-success" : "btn-primary")">
                                                @(Model.CurrentAssignedTrainerId == trainer.TrainerId ? "Reassign" : "Assign Trainer")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No approved trainers currently possess the exact specialization "<strong>@Model.TrainingGoalName</strong>".
                </div>
            }
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- OTHER APPROVED TRAINERS (NON-EXACT MATCHES) (PART G & L)          -->
    <!-- ================================================================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-0 fw-bold">
                    Other Approved Trainers (@Model.OtherApprovedTrainers.Count)
                </h5>
                <span class="text-muted small">Trainers registered in different training domains</span>
            </div>
            <span class="badge bg-warning-subtle text-dark border border-warning">Requires Explicit Confirmation</span>
        </div>
        <div class="card-body p-0">
            @if (Model.OtherApprovedTrainers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trainer Name</th>
                                <th>Contact</th>
                                <th>Specializations</th>
                                <th>Active Workload</th>
                                <th>Hire Date</th>
                                <th class="text-end">Manual Assignment Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trainer in Model.OtherApprovedTrainers)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @trainer.FullName
                                            @if (Model.CurrentAssignedTrainerId == trainer.TrainerId)
                                            {
                                                <span class="badge bg-secondary ms-1">Currently Assigned</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">@trainer.Email</div>
                                        <div class="text-muted small">@trainer.Phone</div>
                                    </td>
                                    <td>
                                        @foreach (var s in trainer.Specializations)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@s</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary px-2 py-1">
                                            Active: @trainer.ActiveWorkload
                                        </span>
                                    </td>
                                    <td class="text-nowrap small">
                                        @trainer.HireDate.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="Assign" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MembershipId" value="@Model.MembershipId" />
                                            <input type="hidden" name="TrainerId" value="@trainer.TrainerId" />
                                            <input type="hidden" name="ConfirmNonExact" value="true" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning text-dark fw-semibold"
                                                    onclick="return confirm('Warning: This trainer does not have the member\'s selected training specialization (@Model.TrainingGoalName).\n\nDo you want to confirm this manual assignment?');">
                                                Assign (Override) &rarr;
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No other approved trainers available.
                </div>
            }
        </div>
    </div>
</div>
